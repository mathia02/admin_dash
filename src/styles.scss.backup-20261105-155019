  font-size: 10px;
}

.wh-pending-list {
  margin-top: 18px;
}

.wh-pending-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 10px;

  padding: 17px 2px;
  border-bottom: 1px solid #28435a;

  color: #c4d9ea;
  font-size: 12px;
}

.wh-pending-item strong {
  color: #82e5f8;
}

.wh-quick-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 13px;
  margin-top: 20px;
}

.wh-quick-link {
  display: flex;
  flex-direction: column;
  gap: 12px;

  padding: 20px;
  border: 1px solid #30516c;
  border-radius: 14px;
  background: #112b42;
  color: #e6f4ff;
}

.wh-quick-link:hover {
  border-color: #27c8f0;
  background: #153c5a;
}

.wh-quick-link > span {
  font-size: 26px;
}

.wh-quick-link strong {
  font-size: 13px;
}

.wh-quick-link small {
  color: #70d2f5;
  font-size: 11px;
}

/* SETTINGS */

.wh-settings-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 17px;
}

.wh-settings-card {
  padding: 25px;
}

.wh-settings-card p {
  margin-bottom: 22px;
}

.wh-settings-wide {
  grid-column: 1 / -1;
}

.wh-toggle-row {
  display: flex;
  justify-content: space-between;
  align-items: center;

  gap: 16px;
  padding: 15px 0;
  border-bottom: 1px solid #28435a;

  font-size: 12px;
  color: #c4dcf0;
}

.wh-toggle-row input {
  accent-color: #12bdd9;
  width: 18px;
  height: 18px;
}

.wh-activity-line {
  display: flex;
  flex-direction: column;
  gap: 4px;

  padding: 12px 0;
  border-bottom: 1px solid #294258;
}

.wh-activity-line span {
  font-size: 12px;
}

.wh-activity-line small {
  color: #7ba5bf;
}

.wh-success-message {
  color: #8af0bd !important;
  margin-top: 14px !important;
}

/* MOBILE */

.wh-mobile-overlay {
  display: none;
}

@media (max-width: 1200px) {
  .wh-metric-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .wh-dashboard-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 850px) {

  .wh-side {
    position: fixed;
    left: 0;
    top: 0;
    bottom: 0;
    z-index: 1001;

    width: min(280px, 85vw);
    height: 100dvh;

    transform: translateX(-105%);
    transition: transform .25s;
  }

  .wh-side-open {
    transform: translateX(0);
  }

  .wh-mobile-overlay {
    display: block;
    position: fixed;
    inset: 0;
    z-index: 1000;

    background: rgba(0, 0, 0, .60);
    border: 0;
  }

  .wh-menu-toggle {
    display: inline-block;
  }

  .wh-view {
    padding: 20px;
  }

  .wh-quick-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .wh-settings-grid {
    grid-template-columns: 1fr;
  }

  .wh-settings-wide {
    grid-column: auto;
  }

  .wh-page-heading,
  .wh-table-head {
    flex-direction: column;
    align-items: stretch;
  }
}

@media (max-width: 560px) {

  .wh-top {
    padding: 13px 16px;
  }

  .wh-top-left h2 {
    font-size: 15px;
  }

  .wh-top-right .wh-demo-tag {
    display: none;
  }

  .wh-view {
    padding: 14px;
  }

  .wh-metric-grid {
    grid-template-columns: 1fr 1fr;
    gap: 9px;
  }

  .wh-metric-card {
    min-height: 112px;
    padding: 15px;
  }

  .wh-metric-card strong {
    font-size: 25px;
  }

  .wh-heading-actions .wh-btn {
    flex: 1;
  }

  .wh-toolbar {
    width: 100%;
  }

  .wh-search,
  .wh-toolbar select {
    width: 100%;
    flex: 1;
  }

  .wh-table-head,
  .wh-chart-card,
  .wh-settings-card {
    padding: 18px;
  }

  .wh-detail-grid,
  .wh-editor-grid {
    grid-template-columns: 1fr;
  }

  .wh-modal {
    padding: 20px;
  }

  .wh-modal-actions .wh-btn {
    width: 100%;
  }

  .wh-quick-grid {
    grid-template-columns: 1fr 1fr;
  }

  .wh-quick-link {
    padding: 14px;
  }
}

/* WH_ADMIN_ALL_END */

