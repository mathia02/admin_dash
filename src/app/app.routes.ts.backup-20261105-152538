import { Routes } from '@angular/router';
import { adminAuthGuard } from './core/guards/admin-auth.guard';

export const routes: Routes = [

  {
    path: 'auth',
    loadComponent: () =>
      import('./features/authentication/auth-layout')
        .then(m => m.AuthLayout),
    children: [
      {
        path: '',
        pathMatch: 'full',
        redirectTo: 'login'
      },
      {
        path: 'login',
        loadComponent: () =>
          import('./features/authentication/login/login')
            .then(m => m.Login)
      },
      {
        path: 'verify-code',
        loadComponent: () =>
          import('./features/authentication/verify-code/verify-code')
            .then(m => m.VerifyCode)
      },
      {
        path: 'forgot-password',
        loadComponent: () =>
          import('./features/authentication/forgot-password/forgot-password')
            .then(m => m.ForgotPassword)
      },
      {
        path: 'reset-password',
        loadComponent: () =>
          import('./features/authentication/reset-password/reset-password')
            .then(m => m.ResetPassword)
      }
    ]
  },

  {
    path: '',
    canActivate: [adminAuthGuard],
    loadComponent: () =>
      import('./layout/admin-layout/admin-layout')
        .then(m => m.AdminLayout),
    children: [
      {
        path: 'dashboard',
        loadComponent: () =>
          import('./features/dashboard/dashboard-page/dashboard-page')
            .then(m => m.DashboardPage)
      },

      ...[
        { path: 'users', title: 'User Management' },
        { path: 'location-verification', title: 'Location Verification' },
        { path: 'advertisements', title: 'Advertisement Management' },
        { path: 'places', title: 'Places Management' },
        { path: 'trips-historical-routes', title: 'Trips & Historical Routes' },
        { path: 'hazards', title: 'Hazard Management' },
        { path: 'group-trips', title: 'Group Trip Management' },
        { path: 'games', title: 'Games Management' },
        { path: 'wallet-rewards', title: 'Wallet & Rewards' },
        { path: 'merchants', title: 'Merchant Management' },
        { path: 'reports-analytics', title: 'Reports & Analytics' },
        { path: 'settings', title: 'Admin Settings' }
      ].map(item => ({
        path: item.path,
        data: { title: item.title },
        loadComponent: () =>
          import('./shared/ui/module-placeholder')
            .then(m => m.ModulePlaceholder)
      }))
    ]
  },

  {
    path: '',
    pathMatch: 'full',
    redirectTo: 'auth/login'
  },

  {
    path: '**',
    redirectTo: 'auth/login'
  }
];
