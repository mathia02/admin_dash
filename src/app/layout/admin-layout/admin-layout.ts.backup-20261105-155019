import { Component } from '@angular/core';
import {
  Router,
  RouterLink,
  RouterLinkActive,
  RouterOutlet
} from '@angular/router';
import { AuthService } from '../../core/auth/auth.service';

@Component({
  selector: 'app-admin-layout',
  standalone: true,
  imports: [RouterOutlet, RouterLink, RouterLinkActive],
  template: `
    <div class="wh-admin2">

      @if (menuOpen) {
        <button
          class="wh-mobile-overlay"
          aria-label="Close sidebar"
          (click)="menuOpen = false"
        ></button>
      }

      <aside class="wh-side" [class.wh-side-open]="menuOpen">

        <div class="wh-side-brand">
          <img
            src="/images/logo/wayhunter-logo.jpg"
            alt="WayHunter Original Logo"
          />
          <div>
            <strong>WAYHUNTER</strong>
            <small>ADMIN CONTROL CENTER</small>
          </div>
        </div>

        <div class="wh-side-title">MAIN MENU</div>

        <nav class="wh-side-nav">
          @for (item of menu; track item.route) {
            <a
              [routerLink]="item.route"
              routerLinkActive="wh-nav-active"
              (click)="menuOpen = false"
              class="wh-nav-link"
            >
              <span class="wh-nav-icon">{{ item.icon }}</span>
              <span>{{ item.label }}</span>
            </a>
          }
        </nav>

        <div class="wh-side-bottom">
          <div class="wh-admin-user">
            <div class="wh-user-avatar">A</div>
            <div>
              <strong>Administrator</strong>
              <small>Single Admin  Demo</small>
            </div>
          </div>

          <button class="wh-signout" (click)="logout()">
            Sign Out
          </button>
        </div>

      </aside>

      <div class="wh-content">

        <header class="wh-top">
          <div class="wh-top-left">
            <button
              class="wh-menu-toggle"
              aria-label="Open navigation"
              (click)="menuOpen = !menuOpen"
            >
              
            </button>

            <div>
              <small>WAYHUNTER PLATFORM</small>
              <h2>Admin Control Center</h2>
            </div>
          </div>

          <div class="wh-top-right">
            <span class="wh-demo-tag">DEMO MODE</span>
            <div class="wh-user-avatar">A</div>
          </div>
        </header>

        <main class="wh-view">
          <router-outlet></router-outlet>
        </main>

      </div>

    </div>
  `
})
export class AdminLayout {

  menuOpen = false;

  menu = [
    { label: 'Dashboard', icon: '', route: '/dashboard' },
    { label: 'Users', icon: '', route: '/users' },
    { label: 'Location Verification', icon: '', route: '/location-verification' },
    { label: 'Advertisements', icon: '', route: '/advertisements' },
    { label: 'Places', icon: '', route: '/places' },
    { label: 'Trips & Routes', icon: '', route: '/trips-historical-routes' },
    { label: 'Hazards', icon: '', route: '/hazards' },
    { label: 'Group Trips', icon: '', route: '/group-trips' },
    { label: 'Games', icon: '', route: '/games' },
    { label: 'Wallet & Rewards', icon: '', route: '/wallet-rewards' },
    { label: 'Merchants', icon: '', route: '/merchants' },
    { label: 'Reports', icon: '', route: '/reports-analytics' },
    { label: 'Settings', icon: '', route: '/settings' }
  ];

  constructor(
    private auth: AuthService,
    private router: Router
  ) {}

  logout(): void {
    this.auth.logout();
    this.router.navigate(['/auth/login']);
  }
}
