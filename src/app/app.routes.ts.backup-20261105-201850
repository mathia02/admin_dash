import { Routes } from '@angular/router';
import { adminAuthGuard } from './core/guards/admin-auth.guard';

export const routes: Routes = [

  {
    path: 'auth',
    loadComponent: () =>
      import('./features/authentication/auth-layout')
        .then(m => m.AuthLayout),
    children: [
      { path: '', pathMatch: 'full', redirectTo: 'login' },

      {
        path: 'login',
        loadComponent: () =>
          import('./features/authentication/login/login')
            .then(m => m.Login)
      },
      {
        path: 'verify-code',
        loadComponent: () =>
          import('./features/authentication/verify-code/verify-code')
            .then(m => m.VerifyCode)
      },
      {
        path: 'forgot-password',
        loadComponent: () =>
          import('./features/authentication/forgot-password/forgot-password')
            .then(m => m.ForgotPassword)
      },
      {
        path: 'reset-password',
        loadComponent: () =>
          import('./features/authentication/reset-password/reset-password')
            .then(m => m.ResetPassword)
      }
    ]
  },

  {
    path: '',
    canActivate: [adminAuthGuard],
    loadComponent: () =>
      import('./layout/admin-layout/admin-layout')
        .then(m => m.AdminLayout),

    children: [
      { path: '', pathMatch: 'full', redirectTo: 'dashboard' },

      {
        path: 'dashboard',
        loadComponent: () =>
          import('./features/dashboard/dashboard-page/dashboard-page')
            .then(m => m.DashboardPage)
      },
      {
        path: 'users',
        loadComponent: () =>
          import('./features/users/users-page')
            .then(m => m.UsersPage)
      },
      {
        path: 'location-verification',
        loadComponent: () =>
          import('./features/location-verification/location-verification-page')
            .then(m => m.LocationVerificationPage)
      },
      {
        path: 'advertisements',
        loadComponent: () =>
          import('./features/advertisements/advertisements-page')
            .then(m => m.AdvertisementsPage)
      },
      {
        path: 'places',
        loadComponent: () =>
          import('./features/places/places-page')
            .then(m => m.PlacesPage)
      },
      {
        path: 'trips-historical-routes',
        loadComponent: () =>
          import('./features/trips-historical-routes/trips-historical-routes-page')
            .then(m => m.TripsHistoricalRoutesPage)
      },
      {
        path: 'hazards',
        loadComponent: () =>
          import('./features/hazards/hazards-page')
            .then(m => m.HazardsPage)
      },
      {
        path: 'group-trips',
        loadComponent: () =>
          import('./features/group-trips/group-trips-page')
            .then(m => m.GroupTripsPage)
      },
      {
        path: 'games',
        loadComponent: () =>
          import('./features/games/games-page')
            .then(m => m.GamesPage)
      },
      {
        path: 'wallet-rewards',
        loadComponent: () =>
          import('./features/wallet-rewards/wallet-rewards-page')
            .then(m => m.WalletRewardsPage)
      },
      {
        path: 'merchants',
        loadComponent: () =>
          import('./features/merchants/merchants-page')
            .then(m => m.MerchantsPage)
      },
      {
        path: 'reports-analytics',
        loadComponent: () =>
          import('./features/reports-analytics/reports-analytics-page')
            .then(m => m.ReportsAnalyticsPage)
      },
      {
        path: 'settings',
        loadComponent: () =>
          import('./features/settings/settings-page')
            .then(m => m.SettingsPage)
      }
    ]
  },

  { path: '**', redirectTo: 'auth/login' }

];
