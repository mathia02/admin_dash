@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Outfit:wght@400;500;600;700;800&display=swap');

:root {
  font-family: 'DM Sans', sans-serif;
  color: #eaf4ff;
  background: #070f1d;
  font-synthesis: none;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  min-height: 100vh;
  background: #070f1d;
}

button, input {
  font: inherit;
}

button {
  cursor: pointer;
}

a {
  text-decoration: none;
}

h1, h2, h3, h4 {
  font-family: 'Outfit', sans-serif;
  margin-top: 0;
}

/* AUTH LAYOUT */

.auth-layout {
  display: grid;
  grid-template-columns: minmax(0, 1.12fr) minmax(420px, .88fr);
  min-height: 100vh;
  background: #091323;
}

.auth-brand-panel {
  position: relative;
  padding: 38px 7%;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  background:
    radial-gradient(circle at 45% 44%, rgba(0, 166, 255, .17), transparent 38%),
    linear-gradient(135deg, #091f36 0%, #091626 52%, #06101e 100%);
}

.auth-brand-panel::after {
  content: "";
  position: absolute;
  inset: 0;
  pointer-events: none;
  opacity: .18;
  background-image:
    linear-gradient(rgba(102, 197, 251, .13) 1px, transparent 1px),
    linear-gradient(90deg, rgba(102, 197, 251, .13) 1px, transparent 1px);
  background-size: 46px 46px;
  mask-image: linear-gradient(to bottom, transparent, black, transparent);
}

.ambient {
  position: absolute;
  border-radius: 50%;
  filter: blur(65px);
  pointer-events: none;
}

.ambient-one {
  width: 300px;
  height: 300px;
  background: rgba(0, 132, 255, .15);
  top: 20%;
  left: -100px;
}

.ambient-two {
  width: 270px;
  height: 270px;
  background: rgba(227, 158, 35, .10);
  right: -130px;
  bottom: 12%;
}

.brand-top {
  display: flex;
  align-items: center;
  gap: 15px;
  z-index: 1;
}

.brand-mark {
  height: 57px;
  width: 57px;
  padding: 4px;
  border-radius: 15px;
  background: rgba(255, 255, 255, .07);
  border: 1px solid rgba(255, 255, 255, .12);
  overflow: hidden;
}

.brand-mark img {
  width: 100%;
  height: 100%;
  object-fit: contain;
}

.brand-name {
  font-family: Outfit, sans-serif;
  font-size: 21px;
  font-weight: 800;
  letter-spacing: 2px;
}

.brand-subtitle {
  color: #83adc8;
  font-size: 10px;
  letter-spacing: 2px;
}

.brand-hero {
  position: relative;
  z-index: 1;
  margin: auto 0;
  padding: 34px 0;
}

.hero-label, .eyebrow {
  color: #67d7fa;
  font-size: 11px;
  letter-spacing: 2.5px;
  font-weight: 800;
}

.hero-image-frame {
  width: min(100%, 430px);
  height: 230px;
  margin: 22px 0 24px;
  padding: 13px;
  border-radius: 24px;
  border: 1px solid rgba(138, 209, 255, .24);
  background: linear-gradient(135deg, rgba(53, 121, 178, .14), rgba(13, 28, 47, .43));
  box-shadow: 0 30px 70px rgba(0, 0, 0, .22);
  backdrop-filter: blur(12px);
}

.hero-image-frame img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  border-radius: 14px;
}

.brand-hero h1 {
  margin: 0;
  font-size: clamp(38px, 4.2vw, 67px);
  line-height: 1.08;
  letter-spacing: -2px;
  font-weight: 800;
}

.brand-hero h1 span {
  color: #56d0f8;
}

.brand-hero p {
  max-width: 530px;
  color: #a7bed5;
  line-height: 1.8;
  font-size: 14px;
}

.hero-feature-row {
  display: flex;
  flex-wrap: wrap;
  gap: 9px;
  margin-top: 24px;
}

.hero-feature-row span {
  padding: 9px 12px;
  border-radius: 100px;
  border: 1px solid rgba(121, 194, 240, .18);
  background: rgba(255,255,255,.035);
  color: #9cc6e0;
  font-size: 10px;
  letter-spacing: 1px;
}

.brand-footer {
  display: flex;
  justify-content: space-between;
  gap: 15px;
  color: #7198b3;
  font-size: 10px;
  letter-spacing: 1.5px;
  z-index: 1;
}

.auth-content-panel {
  min-height: 100vh;
  padding: 35px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background:
    radial-gradient(circle at 90% 5%, rgba(43, 140, 208, .10), transparent 40%),
    #0b1423;
}

.auth-panel-inner {
  width: 100%;
  max-width: 460px;
  margin: auto 0;
}

.auth-card {
  width: 100%;
  padding: 43px 40px;
  border: 1px solid rgba(139, 194, 227, .15);
  border-radius: 26px;
  background: rgba(19, 36, 56, .72);
  box-shadow: 0 25px 80px rgba(0, 0, 0, .32);
  backdrop-filter: blur(22px);
}

.auth-card h2 {
  margin: 13px 0 7px;
  font-size: 35px;
  font-weight: 800;
  letter-spacing: -1px;
  color: #f5faff;
}

.auth-description {
  color: #92acc5;
  font-size: 14px;
  line-height: 1.7;
  margin-bottom: 30px;
}

.field {
  margin-bottom: 21px;
}

.field label {
  display: block;
  color: #d9eaf7;
  font-size: 12px;
  font-weight: 700;
  margin-bottom: 10px;
}

.field input {
  width: 100%;
  height: 52px;
  border: 1px solid #284159;
  outline: none;
  color: #f4faff;
  background: rgba(5, 17, 31, .78);
  border-radius: 11px;
  padding: 0 17px;
  transition: .2s ease;
}

.field input::placeholder {
  color: #63809b;
}

.field input:focus {
  border-color: #38bdf8;
  box-shadow: 0 0 0 3px rgba(56,189,248,.11);
}

.field-heading {
  display: flex;
  justify-content: space-between;
  gap: 10px;
  align-items: center;
  margin-bottom: 9px;
}

.field-heading label {
  margin: 0;
}

.field-heading a {
  color: #6fcef9;
  font-size: 12px;
}

.password-field {
  position: relative;
}

.password-field input {
  padding-right: 75px;
}

.password-toggle {
  position: absolute;
  top: 50%;
  right: 12px;
  transform: translateY(-50%);
  border: 0;
  color: #6fd0f6;
  background: transparent;
  font-size: 12px;
}

.primary-btn {
  width: 100%;
  height: 53px;
  border: none;
  border-radius: 12px;
  padding: 0 20px;
  background: linear-gradient(115deg, #0479c8, #17a6db, #18bfc8);
  color: white;
  font-weight: 800;
  box-shadow: 0 10px 26px rgba(4,130,202,.23);
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 14px;
  transition: transform .2s, box-shadow .2s;
}

.primary-btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 14px 30px rgba(4,130,202,.34);
}

.primary-btn span {
  font-size: 19px;
}

.message {
  font-size: 12px;
  padding: 12px 14px;
  margin: 8px 0 16px;
  border-radius: 9px;
}

.message.error {
  color: #ffc7c7;
  border: 1px solid rgba(255, 110, 110, .28);
  background: rgba(230, 65, 80, .12);
}

.message.success {
  color: #9af4c0;
  background: rgba(15, 160, 110, .14);
}

.demo-hint {
  margin-top: 24px;
  padding: 14px;
  color: #9bbad2;
  font-size: 12px;
  line-height: 1.8;
  border-radius: 12px;
  background: rgba(40, 80, 110, .17);
  border: 1px dashed rgba(100, 180, 225, .19);
}

.demo-hint strong {
  color: #dcefff;
}

.secure-label {
  margin-top: 25px;
  text-align: center;
  font-size: 11px;
  color: #718faa;
}

.auth-symbol {
  font-size: 40px;
  color: #56d2fb;
  margin-top: 20px;
}

.otp-input {
  font-size: 29px !important;
  text-align: center;
  letter-spacing: 12px;
  font-weight: 800;
}

.back-link {
  display: block;
  margin-top: 24px;
  text-align: center;
  color: #74d1f6;
  font-size: 13px;
}

.auth-copyright {
  color: #587993;
  font-size: 11px;
  text-align: center;
  margin-top: 30px;
}

.auth-mobile-brand {
  display: none;
}

/* ADMIN LAYOUT */

.admin-shell {
  display: flex;
  min-height: 100vh;
  background: #08111f;
}

.admin-sidebar {
  width: 258px;
  flex: 0 0 258px;
  background: #0c1a2d;
  border-right: 1px solid #1a314a;
  display: flex;
  flex-direction: column;
  padding: 24px 13px;
}

.sidebar-brand {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 5px 12px 29px;
}

.sidebar-brand img {
  height: 47px;
  width: 47px;
  object-fit: contain;
  border-radius: 12px;
}

.sidebar-brand strong {
  display: block;
  font-size: 15px;
  font-family: Outfit, sans-serif;
  letter-spacing: 1px;
}

.sidebar-brand small {
  display: block;
  color: #789bb4;
  font-size: 9px;
  letter-spacing: 2px;
  margin-top: 4px;
}

.sidebar-section-label {
  padding: 8px 14px 13px;
  color: #6689a3;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 1.7px;
}

.sidebar-nav {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.sidebar-link {
  min-height: 39px;
  display: flex;
  align-items: center;
  gap: 13px;
  padding: 10px 13px;
  border-radius: 10px;
  color: #a2bcd1;
  font-size: 12px;
  transition: .2s;
}

.sidebar-link:hover,
.sidebar-link.active {
  background: #164368;
  color: #ffffff;
}

.sidebar-icon {
  min-width: 19px;
  text-align: center;
  font-size: 17px;
  color: #64c9f5;
}

.sidebar-bottom {
  margin-top: auto;
  padding: 25px 7px 0;
}

.admin-identity {
  display: flex;
  align-items: center;
  gap: 11px;
  padding: 12px 5px;
  border-top: 1px solid #29415b;
}

.admin-avatar, .topbar-avatar {
  width: 37px;
  height: 37px;
  border-radius: 12px;
  background: linear-gradient(135deg, #037ad4, #27c9cc);
  color: #fff;
  display: grid;
  place-items: center;
  font-weight: 800;
}

.admin-identity strong {
  display: block;
  font-size: 12px;
}

.admin-identity small {
  display: block;
  color: #80a0ba;
  font-size: 10px;
  margin-top: 4px;
}

.logout-btn {
  width: 100%;
  margin-top: 9px;
  border: 1px solid #31516e;
  background: transparent;
  color: #a3d4f4;
  height: 39px;
  border-radius: 10px;
}

.admin-workspace {
  min-width: 0;
  flex: 1;
}

.admin-topbar {
  height: 82px;
  border-bottom: 1px solid #193047;
  background: #0c192a;
  padding: 15px 30px;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.topbar-label {
  color: #63c1e9;
  font-size: 9px;
  letter-spacing: 1.8px;
  font-weight: 800;
}

.admin-topbar h3 {
  font-size: 18px;
  margin: 5px 0 0;
}

.topbar-right {
  display: flex;
  align-items: center;
  gap: 16px;
}

.demo-status {
  font-size: 10px;
  padding: 9px 12px;
  background: #183952;
  border-radius: 100px;
  color: #9be1fd;
  letter-spacing: 1px;
}

.admin-page-content {
  padding: 30px;
  max-width: 1600px;
  margin: 0 auto;
}

/* DASHBOARD */

.dashboard-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 26px;
}

.dashboard-heading h1 {
  font-size: 32px;
  margin: 10px 0 5px;
}

.dashboard-heading p {
  margin: 0;
  color: #91afc7;
  font-size: 13px;
}

.dashboard-demo-tag, .widget-tag {
  color: #80dbf7;
  border: 1px solid #234e6e;
  background: #102d45;
  padding: 9px 13px;
  border-radius: 10px;
  font-size: 10px;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16px;
}

.stat-card, .dashboard-widget {
  border: 1px solid #203850;
  border-radius: 17px;
  background: linear-gradient(145deg, #102238, #0e1c30);
  box-shadow: 0 15px 32px rgba(0,0,0,.11);
}

.stat-card {
  padding: 23px;
}

.stat-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #9ebad0;
  font-size: 12px;
}

.stat-symbol {
  color: #51c5f0;
  font-size: 25px;
}

.stat-value {
  margin-top: 11px;
  font-size: 35px;
  font-weight: 800;
  font-family: Outfit, sans-serif;
}

.stat-caption {
  margin-top: 6px;
  font-size: 11px;
  color: #7498b1;
}

.dashboard-lower-grid {
  display: grid;
  grid-template-columns: 1.45fr 1fr;
  gap: 16px;
  margin-top: 17px;
}

.dashboard-widget {
  padding: 24px;
}

.widget-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.widget-header h3 {
  font-size: 18px;
  margin: 0 0 5px;
}

.widget-header p {
  margin: 0;
  color: #789ab4;
  font-size: 12px;
}

.demo-chart {
  display: flex;
  align-items: end;
  height: 205px;
  gap: 12px;
  padding-top: 25px;
}

.chart-column {
  flex: 1;
  display: flex;
  align-items: end;
  height: 100%;
  background: rgba(31, 77, 111, .12);
  border-radius: 8px 8px 0 0;
}

.chart-bar {
  width: 100%;
  border-radius: 8px 8px 0 0;
  background: linear-gradient(to top, #075cbd, #18c9e0);
}

.chart-labels {
  display: flex;
  justify-content: space-between;
  color: #789db8;
  font-size: 10px;
  margin-top: 11px;
}

.quick-overview {
  margin-top: 18px;
}

.quick-overview div {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  border-bottom: 1px solid #22394f;
  padding: 15px 0;
  font-size: 12px;
}

.quick-overview span {
  color: #a1b9ce;
}

.quick-overview strong {
  color: #75d7f6;
}

.dashboard-note {
  margin-top: 22px;
  padding: 17px;
  border: 1px solid #23445e;
  border-radius: 12px;
  background: #102539;
  font-size: 12px;
  color: #a4c2d6;
  line-height: 1.7;
}

/* MODULE PLACEHOLDER */

.module-placeholder {
  max-width: 700px;
  margin: 75px auto;
  padding: 55px 30px;
  text-align: center;
  border-radius: 22px;
  border: 1px solid #27445c;
  background: linear-gradient(145deg, #10273d, #0b1929);
}

.placeholder-icon {
  color: #57d0f3;
  font-size: 56px;
  margin: 28px 0 14px;
}

.module-placeholder h1 {
  font-size: 30px;
}

.module-placeholder p {
  color: #94b6cc;
  line-height: 1.8;
}

.placeholder-label {
  color: #7adbf9;
  font-size: 11px;
  letter-spacing: 1px;
  margin: 25px 0;
}

.inline-btn {
  display: inline-flex;
  width: auto;
  text-decoration: none;
}

/* RESPONSIVE */

@media (max-width: 1050px) {
  .auth-layout {
    grid-template-columns: 1fr;
  }

  .auth-brand-panel {
    display: none;
  }

  .auth-mobile-brand {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 20px;
    font-family: Outfit, sans-serif;
    letter-spacing: 2px;
  }

  .auth-mobile-brand img {
    width: 42px;
    height: 42px;
    object-fit: contain;
    border-radius: 10px;
  }

  .stats-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .dashboard-lower-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 720px) {
  .auth-content-panel {
    padding: 20px;
  }

  .auth-card {
    padding: 30px 23px;
  }

  .admin-shell {
    display: block;
  }

  .admin-sidebar {
    width: 100%;
    max-height: 240px;
    overflow-y: auto;
  }

  .sidebar-nav {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
  }

  .sidebar-bottom {
    display: none;
  }

  .admin-topbar {
    padding: 14px;
  }

  .admin-page-content {
    padding: 17px;
  }

  .stats-grid {
    grid-template-columns: 1fr;
  }

  .dashboard-heading {
    align-items: flex-start;
    flex-direction: column;
  }
}


/* WAYHUNTER_NATURE_AUTH_START */

/* =========================================
   WAYHUNTER NATURAL GLASSMORPHISM LOGIN
========================================= */

.wh-nature-auth {
  position: relative;
  width: 100%;
  min-height: 100vh;
  min-height: 100dvh;
  overflow: hidden;
  isolation: isolate;
  display: flex;
  flex-direction: column;
  font-family: 'DM Sans', sans-serif;

  background: linear-gradient(
    125deg,
    #234d48,
    #172e3f,
    #071827
  );
}

/* Natural photo background */

.wh-nature-background {
  position: absolute;
  inset: -18px;
  z-index: -3;

  background-image: url(
    'https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?auto=format&fit=crop&w=2400&q=85'
  );

  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;

  animation: whNatureZoom 24s ease-in-out infinite alternate;
}

/* Cinematic transparent overlay */

.wh-nature-overlay {
  position: absolute;
  inset: 0;
  z-index: -2;

  background:
    linear-gradient(
      90deg,
      rgba(2, 14, 22, 0.22) 0%,
      rgba(2, 13, 22, 0.30) 45%,
      rgba(2, 12, 22, 0.56) 100%
    ),
    linear-gradient(
      180deg,
      rgba(2, 13, 25, 0.25) 0%,
      rgba(2, 13, 25, 0.08) 55%,
      rgba(1, 10, 19, 0.40) 100%
    );
}

/* Original logo */

.wh-nature-header {
  position: relative;
  z-index: 5;

  display: flex;
  align-items: center;
  gap: 17px;

  width: fit-content;
  padding: 34px 5%;
}

.wh-nature-logo {
  width: 77px;
  height: 77px;
  object-fit: cover;
  border-radius: 19px;

  border: 1px solid rgba(255, 255, 255, 0.40);

  box-shadow:
    0 12px 36px rgba(0, 0, 0, 0.35),
    0 0 26px rgba(0, 200, 255, 0.18);

  transition: transform 0.3s ease;
}

.wh-nature-logo:hover {
  transform: scale(1.05);
}

.wh-nature-brand {
  display: flex;
  flex-direction: column;
  gap: 6px;

  text-shadow: 0 2px 15px rgba(0, 0, 0, 0.6);
}

.wh-nature-brand strong {
  font-family: 'Outfit', sans-serif;
  font-size: 25px;
  font-weight: 800;
  letter-spacing: 2px;
  color: #ffffff;
}

.wh-nature-brand span {
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 2.5px;
  color: #c3edfa;
}

/* Right side glass form positioning */

.wh-nature-content {
  position: relative;
  z-index: 2;

  flex: 1;
  display: flex;
  align-items: center;
  justify-content: flex-end;

  width: 100%;
  padding: 35px clamp(25px, 7vw, 140px) 85px;
}

.wh-nature-card {
  width: min(100%, 470px);

  animation: whGlassEntrance 0.8s ease both;
}

/* Main transparent login glass */

.wh-nature-auth .auth-card {
  width: 100%;
  padding: 43px 40px;

  background: rgba(7, 24, 37, 0.32);

  border: 1px solid rgba(255, 255, 255, 0.32);
  border-radius: 26px;

  backdrop-filter: blur(25px) saturate(145%);
  -webkit-backdrop-filter: blur(25px) saturate(145%);

  box-shadow:
    0 24px 85px rgba(0, 0, 0, 0.35),
    inset 0 1px 0 rgba(255, 255, 255, 0.18);

  transition:
    border-color 0.3s ease,
    box-shadow 0.3s ease;
}

.wh-nature-auth .auth-card:hover {
  border-color: rgba(183, 236, 255, 0.48);

  box-shadow:
    0 30px 95px rgba(0, 0, 0, 0.4),
    0 0 35px rgba(0, 186, 255, 0.08),
    inset 0 1px 0 rgba(255, 255, 255, 0.18);
}

/* Headings */

.wh-nature-auth .eyebrow {
  color: #81e4ff;
  font-size: 11px;
  letter-spacing: 2.3px;
  font-weight: 800;
}

.wh-nature-auth .auth-card h2 {
  color: #ffffff;
  font-size: 37px;
  font-weight: 800;

  text-shadow: 0 3px 20px rgba(0, 0, 0, 0.3);
}

.wh-nature-auth .auth-description {
  color: #dfedf6;
  line-height: 1.7;
}

/* Form labels */

.wh-nature-auth .field label {
  color: #f2faff;
  font-weight: 700;
}

/* Transparent glass input */

.wh-nature-auth .field input {
  height: 54px;
  width: 100%;

  border-radius: 12px;

  color: #ffffff;

  background: rgba(3, 16, 26, 0.36);
  border: 1px solid rgba(224, 247, 255, 0.28);

  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);

  outline: none;
  transition: all 0.25s ease;
}

.wh-nature-auth .field input::placeholder {
  color: rgba(235, 246, 255, 0.65);
}

.wh-nature-auth .field input:focus {
  border-color: #75e2ff;

  background: rgba(3, 16, 26, 0.53);

  box-shadow:
    0 0 0 3px rgba(55, 208, 255, 0.15),
    0 0 20px rgba(0, 195, 255, 0.13);
}

/* Links */

.wh-nature-auth .field-heading a,
.wh-nature-auth .back-link {
  color: #8ee9ff;
  font-weight: 700;
}

.wh-nature-auth .password-toggle {
  color: #9beeff;
  font-weight: 700;
}

/* Sign in button */

.wh-nature-auth .primary-btn {
  height: 54px;
  border-radius: 12px;

  background: linear-gradient(
    110deg,
    #0578ca,
    #0ea5db,
    #20c4c3
  );

  color: #ffffff;
  font-size: 14px;
  font-weight: 800;

  box-shadow:
    0 10px 25px rgba(0, 132, 210, 0.26);

  transition:
    transform 0.25s ease,
    box-shadow 0.25s ease,
    filter 0.25s ease;
}

.wh-nature-auth .primary-btn:hover {
  transform: translateY(-3px);
  filter: brightness(1.1);

  box-shadow:
    0 15px 35px rgba(0, 180, 240, 0.40);
}

/* Hide unwanted frontend demo messages */

.wh-nature-auth .demo-hint,
.wh-nature-auth .secure-label,
.wh-nature-auth .auth-copyright {
  display: none !important;
}

/* Error / success messages */

.wh-nature-auth .message.error {
  background: rgba(160, 19, 42, 0.38);
  border-color: rgba(255, 155, 155, 0.4);
  color: #ffe4e4;
}

.wh-nature-auth .message.success {
  background: rgba(8, 113, 78, 0.36);
  color: #ccffe5;
}

/* Background animation */

@keyframes whNatureZoom {
  from {
    transform: scale(1);
  }

  to {
    transform: scale(1.055);
  }
}

@keyframes whGlassEntrance {
  from {
    opacity: 0;
    transform: translateY(28px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* Tablet responsive */

@media (max-width: 1050px) {
  .wh-nature-content {
    justify-content: center;
    padding: 25px 25px 65px;
  }

  .wh-nature-background {
    background-position: center;
  }
}

/* Mobile responsive */

@media (max-width: 600px) {
  .wh-nature-header {
    padding: 22px 20px;
    gap: 10px;
  }

  .wh-nature-logo {
    width: 51px;
    height: 51px;
    border-radius: 12px;
  }

  .wh-nature-brand strong {
    font-size: 18px;
  }

  .wh-nature-brand span {
    font-size: 8px;
    letter-spacing: 1.5px;
  }

  .wh-nature-content {
    padding: 20px 16px 55px;
  }

  .wh-nature-auth .auth-card {
    padding: 32px 23px;
    border-radius: 20px;
  }

  .wh-nature-auth .auth-card h2 {
    font-size: 30px;
  }
}

/* Accessibility */

@media (prefers-reduced-motion: reduce) {
  .wh-nature-background,
  .wh-nature-card {
    animation: none;
  }
}

/* WAYHUNTER_NATURE_AUTH_END */

